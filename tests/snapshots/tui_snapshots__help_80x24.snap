"│ │                  move focus the other way                                │ │"
"│ │   ↓ / j          Down                                                    │ │"
"│ │                  next row, or scroll down (a list wraps at the end)      │ │"
"│ │   ↑ / k          Up                                                      │ │"
"│ │                  previous row, or scroll up (a list wraps at the top)    │ │"
"│ │   PgDn           Page down                                               │ │"
"│ │                  a screenful down (stops at the end)                     │ │"
"│ │   PgUp           Page up                                                 │ │"
"│ │                  a screenful up (stops at the top)                       │ │"
"│ │   Home / g       First row                                               │ │"
"│ │                  jump to the top                                         │ │"
"│ │   End / G        Last row                                                │ │"
